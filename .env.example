# ========================================
# Configuração Geral
# ========================================
NODE_ENV=development
STAGE=dev
LOG_LEVEL=debug
TIMEZONE=America/Sao_Paulo

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=seu-access-key-id
AWS_SECRET_ACCESS_KEY=seu-secret-access-key

# DynamoDB
DYNAMODB_MESSAGES_TABLE=messages
DYNAMODB_EVENTS_TABLE=events
DYNAMODB_AUDIT_LOGS_TABLE=audit_logs
DYNAMODB_USERS_TABLE=users
DYNAMODB_ENDPOINT=http://localhost:8000  # Para desenvolvimento local

# ========================================
# Auth
# ========================================
JWT_SECRET=gere-com-node--e-crypto-randombytes-48-toString-hex

# ========================================
# Claude API (Anthropic)
# ========================================
CLAUDE_API_KEY=sk-ant-sua-chave-aqui
CLAUDE_MODEL=claude-opus-4.8
CLAUDE_TEMPERATURE=0.3
CLAUDE_MAX_TOKENS=1024

# ========================================
# Google Calendar
# ========================================
GOOGLE_CALENDAR_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=seu-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/callback
GOOGLE_CALENDAR_REFRESH_TOKEN=seu-refresh-token
GOOGLE_CALENDAR_ID=primary

# ========================================
# Evolution API (WhatsApp)
# ========================================
EVOLUTION_API_URL=https://sua-instancia.evolution.ai
EVOLUTION_API_KEY=seu-evolution-api-key
EVOLUTION_PHONE_NUMBER=5511999999999

# Só processa mensagens vindas deste número (dono da conta). Mensagens de
# qualquer outro remetente são ignoradas silenciosamente.
AUTHORIZED_PHONE_NUMBER=5511999999999

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ========================================
# Webhook Configuration
# ========================================
WEBHOOK_SECRET=seu-webhook-secret-aleatorio
API_BASE_URL=http://localhost:3000

# ========================================
# Database Configuration
# ========================================
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000

# ========================================
# Logging
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# ========================================
# Feature Flags
# ========================================
FEATURE_DUPLICATE_CHECK=true
FEATURE_RETRY_ENABLED=true
FEATURE_CACHE_ENABLED=true

# ========================================
# Cache
# ========================================
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE=1000

# ========================================
# Monitoring & Alerting
# ========================================
ENABLE_CLOUDWATCH_MONITORING=true
ENABLE_METRICS_EXPORT=true
METRICS_BATCH_SIZE=100
METRICS_BATCH_INTERVAL_MS=60000

# ========================================
# Development Only
# ========================================
DEBUG=whatsapp-calendar:*
MOCK_EXTERNAL_SERVICES=false
USE_LOCAL_DYNAMODB=true
