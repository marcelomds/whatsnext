{
  "name": "whatsapp-calendar-system",
  "version": "1.0.0",
  "description": "Sistema inteligente de agendamento via WhatsApp usando Claude AI e Google Calendar",
  "main": "src/handlers/whatsapp-handler.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- bash -c \"cd apps/backend && serverless offline start --stage dev\"",
    "build": "tsc",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html",
    "lint": "eslint apps/backend/src/",
    "format": "prettier --write \"apps/backend/src/**/*.js\"",
    "create:tables": "node scripts/create-dynamodb-tables.js",
    "get:google-token": "node scripts/get-google-token.js",
    "deploy:staging": "dotenv -e .env -- bash -c \"cd apps/backend && serverless deploy --stage staging\"",
    "deploy:prod": "dotenv -e .env -- bash -c \"cd apps/backend && serverless deploy --stage prod\"",
    "remove:staging": "cd apps/backend && serverless remove --stage staging",
    "remove:prod": "cd apps/backend && serverless remove --stage prod",
    "logs:dev": "cd apps/backend && serverless logs -f handleWhatsappWebhook --stage dev",
    "logs:staging": "cd apps/backend && serverless logs -f handleWhatsappWebhook --stage staging --follow",
    "logs:prod": "cd apps/backend && serverless logs -f handleWhatsappWebhook --stage prod --follow",
    "status:dev": "cd apps/backend && serverless info --stage dev",
    "status:staging": "cd apps/backend && serverless info --stage staging",
    "status:prod": "cd apps/backend && serverless info --stage prod",
    "create:dashboard": "node scripts/create-cloudwatch-dashboard.js",
    "docker:build": "docker build -f docker/Dockerfile -t whatsapp-calendar:latest .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up",
    "docker:push": "docker tag whatsapp-calendar:latest YOUR_ECR_URI/whatsapp-calendar:latest && docker push YOUR_ECR_URI/whatsapp-calendar:latest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.16.1",
    "@aws-sdk/client-dynamodb": "^3.494.0",
    "@aws-sdk/client-secrets-manager": "^3.495.0",
    "@aws-sdk/lib-dynamodb": "^3.1104.0",
    "@aws-sdk/util-dynamodb": "^3.494.0",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "google-auth-library": "^9.4.1",
    "googleapis": "^118.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.2",
    "node-cache": "^5.1.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@serverless/compose": "^1.3.0",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "prettier": "^3.1.1",
    "serverless": "^3.36.0",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-offline": "^12.0.4",
    "serverless-plugin-tracing": "^2.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "whatsapp",
    "calendar",
    "claude",
    "ai",
    "aws",
    "lambda",
    "dynamodb",
    "google-calendar"
  ],
  "author": "Seu Nome",
  "license": "MIT"
}
